{
  "expo": {
    "name": "CampusCare",
    "slug": "campus-care-mobile",
    "version": "1.0.0",
    "scheme": "campuscare-application",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "CampusCare needs access to your photo library so you can attach photos and videos to incident reports."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#048AF3",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-web-browser",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2a7e35cd-5393-4c24-a09d-16e08cba0545"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yscplln.campuscareapplication"
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.yscplln.campuscareapplication",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "notification": {
      "icon": "./assets/android-icon-monochrome.png",
      "color": "#048AF3",
      "androidMode": "default",
      "androidCollapsedTitle": "CampusCare"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a7e35cd-5393-4c24-a09d-16e08cba0545"
      }
    },
    "owner": "campuscarehso"
  }
}
